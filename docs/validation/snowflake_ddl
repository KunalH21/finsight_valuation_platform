CREATE OR REPLACE FILE FORMAT FINSIGHT_PARQUET_FORMAT
	TYPE = PARQUET
	NULL_IF = ()
;
create or replace task LOAD_BALANCE_SHEETS_TASK
	warehouse=FINSIGHT_WH
	schedule='USING CRON 0 6 1 2,5,8,11 * UTC'
	as COPY INTO FINSIGHT_DB.RAW.RAW_BALANCE_SHEETS
  (ticker, report_date, fiscal_quarter, sector, total_assets, total_liabilities, common_stock, retained_earnings, data_quality_flag)
FROM (
  SELECT
    $1:ticker::varchar,
    $1:date::date,
    $1:fiscal_quarter::varchar,
    SPLIT_PART(SPLIT_PART(METADATA$FILENAME, 'sector=', 2), '/', 1)::varchar AS sector,
    $1:total_assets::double,
    $1:total_liabilities_net_minority_interest::double,
    $1:common_stock::double,
    $1:retained_earnings::double,
    $1:data_quality_flag::varchar
  FROM @balance_sheet_stage
)
FILE_FORMAT = (TYPE = 'PARQUET')
PATTERN = '.*\.parquet'
ON_ERROR = 'CONTINUE';
create or replace task LOAD_BALANCE_SHEET_TASK
	warehouse=FINSIGHT_WH
	schedule='USING CRON 0 6 1 2,5,8,11 * UTC'
	as COPY INTO FINSIGHT_DB.RAW.RAW_BALANCE_SHEET (ticker, report_date, fiscal_quarter, sector, total_assets, total_liabilities, total_equity, common_stock, retained_earnings, data_quality_flag)
FROM (
  SELECT 
    $1:ticker::varchar, 
    $1:date::date,  
    $1:fiscal_quarter::varchar,
    SPLIT_PART(SPLIT_PART(METADATA$FILENAME, 'sector=', 2), '/', 1)::varchar AS sector, 
    $1:total_assets::double, 
    $1:total_liabilities_net_minority_interest::double, 
    -- We map the long yfinance name to our clean column
    $1:total_equity_gross_minority_interest::double, 
    $1:common_stock::double, 
    $1:retained_earnings::double, 
    $1:data_quality_flag::varchar
  FROM @balance_sheet_stage
)
FILE_FORMAT = (TYPE = 'PARQUET')
PATTERN = '.*.parquet'
ON_ERROR = 'CONTINUE'
force = True;
